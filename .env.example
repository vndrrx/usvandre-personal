# Connection string PostgreSQL dari Supabase (Transaction / Session Pooler atau Direct URL)
# Saat di-deploy ke Vercel dengan integrasi Supabase, POSTGRES_URL / DATABASE_URL terisi otomatis.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Opsional: isi jika nama subdomain publikasi Substack Anda berbeda dari @vandroidd
# Contoh: https://namapublikasi.substack.com/feed
SUBSTACK_FEED_URL="https://vandroidd.substack.com/feed"
SUBSTACK_PROFILE_URL="https://substack.com/@vandroidd"
THREADS_URL="https://www.threads.com/@usvandrnr"
